{
  "name": "crm-frontend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "codegen": "openapi-typescript http://localhost:8000/openapi.json -o src/api/generated/schema.d.ts",
    "typecheck": "tsc --noEmit",
    "check:types": "node scripts/typecheck-baseline.mjs",
    "check:types:baseline": "node scripts/typecheck-baseline.mjs --baseline",
    "check:api-imports": "node scripts/check-api-imports.mjs",
    "check:api-imports:baseline": "node scripts/check-api-imports.mjs --baseline",
    "check:bundle-size": "node scripts/check-bundle-size.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "verify": "node scripts/typecheck-baseline.mjs && vitest run"
  },
